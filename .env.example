# Server
PORT=8787
HOST=127.0.0.1

# Comma-separated list of directories this MCP server may read or write.
# Examples:
# ALLOWED_DIRECTORIES=/Users/you/Projects,/Users/you/Documents/Notes
ALLOWED_DIRECTORIES=

# Optional bearer token. If set, clients must send:
# Authorization: Bearer your-token
AUTH_TOKEN=

# Enable mutating tools such as write_text_file and create_directory.
ALLOW_WRITE=false

# Maximum bytes returned by read_text_file.
MAX_READ_BYTES=1048576

# Maximum recursive entries returned by search_files.
MAX_SEARCH_RESULTS=200
